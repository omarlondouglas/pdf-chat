# --- Auth (login simples por env) ---
AUTH_USERNAME=priscila
AUTH_PASSWORD=testepdf
# Gere uma string aleatória forte (>= 32 chars). Ex: openssl rand -hex 32
AUTH_SECRET=troque-por-uma-string-aleatoria-bem-grande-min-16-chars

# --- Supabase ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Service Role Key (NUNCA exponha pro client). Pega em: Project Settings → API
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Claude (escolha UMA das opções abaixo) ---

# Opção A: LOCAL (.env.local) — token único da sua assinatura
# Gere com `claude setup-token` no seu PC
CLAUDE_CODE_OAUTH_TOKEN=

# Opção B: EASYPANEL / Docker — 3 vars que o entrypoint do container monta em ~/.claude/.credentials.json
# Pegue em ~/.claude/.credentials.json no seu PC após login do CLI (campo claudeAiOauth)
CLAUDE_OAUTH_ACCESS_TOKEN=
CLAUDE_OAUTH_REFRESH_TOKEN=
CLAUDE_OAUTH_EXPIRES_AT=

# Opção C: API key (cobrança por créditos, separada da assinatura)
ANTHROPIC_API_KEY=
